{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@database/(.*)$": "<rootDir>/../src/database/$1",
    "@interfaces/(.*)$": "<rootDir>/../src/interfaces/$1",
    "@enums/(.*)$": "<rootDir>/../src/enums/$1",
    "@utils/(.*)$": "<rootDir>/../src/utils/$1",
    "^src/(.*)$": "<rootDir>/../src/$1"
  }
}